# Server-only AI configuration. Never use the VITE_ prefix for secrets.
# Get a Gemini API key from https://aistudio.google.com/apikey
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Upstash Redis REST credentials for atomic, per-GitHub-account monthly quotas.
# Create a Redis database at https://console.upstash.com/ and copy its REST URL/token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub OAuth Device Flow
# Create a GitHub OAuth App and enable Device Flow, then use its public client ID.
# Do not put a GitHub client secret in VITE_* variables.
VITE_GITHUB_CLIENT_ID=