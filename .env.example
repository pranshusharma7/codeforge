# ==============================================================================
# CODEFORGE ONLINE COMPILER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your secrets and API keys:
# cp .env.example .env
# ==============================================================================

# ── 1. CodeForge Public API & External Project Connection ─────────────────────
# Master secret API key for external projects to connect and run code via CodeForge
CODEFORGE_API_KEY=cf_live_your_secret_api_key_here

# ── 2. AI Intelligence Engine (Google Gemini) ─────────────────────────────────
VITE_AI_PROVIDER=gemini
VITE_AI_MODEL=gemini-3.8-flash
VITE_AI_KEY=your_gemini_api_key_here
VITE_AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent

# Optional Third-Party AI Models
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── 3. GitHub OAuth & Developer Profile ───────────────────────────────────────
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# ── 4. Real-Time Collaboration Server ─────────────────────────────────────────
COLLAB_PORT=4000
COLLAB_HOST=0.0.0.0
CLIENT_ORIGINS=http://localhost:8443,http://localhost:5173,http://localhost:3000
JWT_SECRET=codeforge_collab_super_secret_jwt_key_2026
# DATABASE_URL=postgresql://postgres:password@localhost:5432/codeforge_collab

# ── 5. Cloud Compilers & Fallback Execution ───────────────────────────────────
# JUDGE0_API_KEY=
# RAPIDAPI_KEY=

# ── 6. Custom Project Secrets (Auto-injected into code execution) ─────────────
# STRIPE_SECRET_KEY=
# DATABASE_URL=
# CUSTOM_API_KEY=
