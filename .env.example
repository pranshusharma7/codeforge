# ==============================================================================
# CODEFORGE REAL-TIME COLLABORATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Port and Host
COLLAB_PORT=4000
COLLAB_HOST=0.0.0.0

# Permitted Client Frontend Origins (comma-separated)
CLIENT_ORIGINS=http://localhost:8443,http://localhost:5173,http://localhost:3000

# PostgreSQL Database Connection String (Optional: falls back to local file persistence if omitted)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/codeforge_collab

# JWT Secret for Session & Room Authorization Tokens
JWT_SECRET=codeforge_collab_super_secret_jwt_key_2026

# STUN / TURN Configuration for WebRTC Voice & Screen Sharing across strict NATs/Firewalls
# (Google STUN is enabled by default)
# TURN_SERVER_URL=turn:turn.example.com:3478
# TURN_USERNAME=codeforge_turn_user
# TURN_CREDENTIAL=codeforge_turn_password
