# AI provider configuration
# Never commit a real key. For production, point VITE_AI_API_URL at your backend proxy.
VITE_AI_PROVIDER=gemini
VITE_AI_MODEL=gemini-3.6-flash
VITE_AI_KEY=
VITE_AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent

# Get a Gemini API key from Google AI Studio: https://aistudio.google.com/apikey

# OpenAI-compatible example:
# VITE_AI_PROVIDER=openai
# VITE_AI_MODEL=gpt-4o-mini
# VITE_AI_API_URL=https://api.openai.com/v1/chat/completions

# GitHub OAuth Device Flow
# Create a GitHub OAuth App and enable Device Flow, then use its public client ID.
# Do not put a GitHub client secret in VITE_* variables.
VITE_GITHUB_CLIENT_ID=