    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.69.0",
    "monaco-editor": "^0.56.0",
    "peerjs": "^1.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.1",
    "y-monaco": "^0.1.6",
